# Porta em que a API vai rodar
PORT=3000

# Prefixo base de todas as rotas
BASE_URL=/api/v1

# Neon PostgreSQL (Prisma) — copie a "connection string" do painel da Neon.
# Lembre do sslmode=require no final.
DATABASE_URL="postgresql://usuario:senha@ep-xxxxx.neon.tech/verbum?sslmode=require"

# Segredo usado para assinar/validar tokens JWT (rotas de escrita usam isso quando o middleware `auth` for ligado)
JWT_SECRET="troque-por-um-segredo-forte"

# development | production | test
NODE_ENV=development
