# Porta em que a API vai rodar
PORT=3000

# Prefixo base de todas as rotas
BASE_URL=/api/v1

# Neon PostgreSQL (Prisma)
#
# No painel da Neon, na aba "Connect" do seu projeto, existe um toggle
# "Connection pooling" — ligue ele pra pegar a URL com "-pooler" no host.
#
# DATABASE_URL = a connection string COM POOLING (host termina em "-pooler").
# É a que o app usa em runtime. Sem isso, a conexão cai sozinha depois de
# alguns minutos parado (erro "Error { kind: Closed, cause: None }"), porque
# o compute da Neon hiberna e derruba conexões diretas ociosas.
DATABASE_URL="postgresql://usuario:senha@ep-xxxxx-pooler.sa-east-1.aws.neon.tech/verbum?sslmode=require&pgbouncer=true&connect_timeout=15"

# DIRECT_URL = a mesma connection string, mas SEM "-pooler" (conexão direta).
# Só é usada pelo `prisma migrate` e `prisma studio` — o pgbouncer não suporta
# os comandos que essas ferramentas precisam rodar.
DIRECT_URL="postgresql://usuario:senha@ep-xxxxx.sa-east-1.aws.neon.tech/verbum?sslmode=require"

# Segredo usado para assinar/validar tokens JWT (rotas de escrita usam isso quando o middleware `auth` for ligado)
JWT_SECRET="troque-por-um-segredo-forte"

# development | production | test
NODE_ENV=development
